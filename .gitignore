node_modules/
.env
config.json
.api-key
last-run.log

# Local Netlify folder
.netlify

# SEO Reports (keep structure, ignore generated reports)
reports/*.json
seo-data/*.json

# ...except the Search Console reports, which are committed on purpose so the
# indexing state is readable in the repo (GSC Indexing + SEO Monitor workflows).
!seo-data/gsc-status.json
!seo-data/gsc-performance.json

# Keep directory structure
!reports/.gitkeep
!seo-data/.gitkeep
