{
  "name": "shiv-parmar-portfolio",
  "version": "1.0.0",
  "description": "SEO monitoring scripts for Shiv Parmar Portfolio",
  "scripts": {
    "seo:audit": "node scripts/seo-audit.js",
    "seo:meta": "node scripts/check-meta-tags.js",
    "seo:sitemap": "node scripts/validate-sitemap.js",
    "seo:speed": "node scripts/check-pagespeed.js",
    "seo:keywords": "node scripts/track-keywords.js",
    "seo:questions": "node scripts/audit-question-headings.js",
    "seo:competitors": "node scripts/check-competitors.js",
    "seo:html": "node scripts/check-html-seo.js",
    "seo:blog": "node scripts/check-blog-seo.js",
    "seo:gsc": "node scripts/gsc-indexing.js",
    "seo:indexnow": "node scripts/bulk-index-submit.js",
    "seo:report": "node scripts/generate-report.js",
    "seo:all": "npm run seo:audit && npm run seo:meta && npm run seo:sitemap && npm run seo:speed && npm run seo:report",
    "blog:publish": "node scripts/publish-blog.js",
    "blog:quick": "node scripts/quick-publish.js",
    "blog:check": "node scripts/check-blog-seo.js",
    "blog:list": "ls blog/*.html | xargs -I {} basename {} .html",
    "setup:apis": "node scripts/setup-apis.js",
    "email:test": "node scripts/test-email.js",
    "email:fail-test": "node scripts/send-failure-email.js --dry-run",
    "blog:auto": "node scripts/auto-blog-generator.js",
    "blog:retry": "node scripts/retry-generate.js",
    "enhance": "node scripts/enhance.js",
    "rss": "node scripts/generate-rss.js",
    "links": "node scripts/inject-internal-links.js",
    "faq": "node scripts/inject-faq-schema.js",
    "eat": "node scripts/standardize-author-box.js",
    "cwv": "node scripts/optimize-cwv.js",
    "webp": "node scripts/optimize-webp.js",
    "check:links": "node scripts/broken-link-check.js",
    "seo:bing": "node scripts/submit-bing-sitemap.js",
    "seo:syndicate": "node scripts/syndicate-devto.js",
    "test": "node scripts/test-retry.js && node scripts/test-idempotency.js && node scripts/check-blogs.js"
  },
  "keywords": [
    "seo",
    "wordpress",
    "portfolio",
    "keyword-tracking"
  ],
  "author": "Shiv Parmar",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "nodemailer": "^10.0.10"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
